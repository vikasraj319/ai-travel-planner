# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (defaults cover localhost:5173)
CLIENT_URL=http://localhost:5173

# Supabase (used for auth token verification + database access)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# Gemini retires models without notice (a retired model answers with a 404).
# Keep this pinned to a model the key can actually use.
GEMINI_MODEL=gemini-2.5-flash
# Budget for a single chat reply.
AI_TIMEOUT_MS=20000
# Budget for a full itinerary (a large JSON document, so it needs longer).
AI_PLAN_TIMEOUT_MS=60000
# Attempts per AI request, including retries of transient provider failures.
AI_MAX_ATTEMPTS=3
MAX_HISTORY_MESSAGES=12

# Images (Pexels)
PEXELS_API_KEY=your-pexels-api-key

# ---------------------------------------------------------------------------
# Nearby places discovery
# ---------------------------------------------------------------------------
# Provider: "auto" (Google Places if a key is set, else OpenStreetMap),
#           "google" (Google Places only), or "osm" (OpenStreetMap only).
PLACES_PROVIDER=auto

# Optional. Google Places API (New) key. When present it supplies real ratings,
# review counts, price levels, opening hours and provider place IDs.
# Obtain: Google Cloud Console -> APIs & Services -> Credentials.
# NOTE: Google Places is a paid API with a free monthly credit tier. Do not
# enable billing unless you have approved the associated cost.
GOOGLE_PLACES_API_KEY=

# OpenStreetMap services (no API key required).
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Optional comma-separated Overpass mirrors, tried in order when the primary
# endpoint fails (timeout, 429, 5xx). Free public mirrors.
# NOTE: only use *worldwide* instances. Regional instances (for example
# overpass.osm.ch, which only holds Swiss data) return empty results for
# every other country and must not be used as a general fallback.
OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search
# Nominatim's usage policy requires an identifying User-Agent; Overpass mirrors
# reject requests without one. Set a real contact/app identifier in production.
NOMINATIM_USER_AGENT=HorizonsAITravelPlanner/1.0 (you@example.com)
OVERPASS_USER_AGENT=HorizonsAITravelPlanner/1.0 (you@example.com)

# ---------------------------------------------------------------------------
# Live events and festivals
# ---------------------------------------------------------------------------
# Provider: "auto" (Ticketmaster if a key is set, else unavailable) or
#           "ticketmaster". Coverage is limited to Ticketmaster's markets.
EVENTS_PROVIDER=auto
# Obtain: https://developer.ticketmaster.com/ (free Discovery API key)
TICKETMASTER_API_KEY=
TICKETMASTER_API_URL=https://app.ticketmaster.com/discovery/v2/events.json

# ---------------------------------------------------------------------------
# External API resilience and caching
# ---------------------------------------------------------------------------
# Per-request timeout for a single external API call.
EXTERNAL_API_TIMEOUT_MS=8000
# Total wall-clock budget for one /api/places/nearby request. Failing over
# between Overpass mirrors can never exceed this budget.
PLACES_REQUEST_BUDGET_MS=9000
# Timeout for a single Overpass/Google attempt.
PLACES_ATTEMPT_TIMEOUT_MS=5000
# Maximum number of provider attempts (retries + mirror failover combined).
PLACES_MAX_ATTEMPTS=3
# Exponential backoff between retries of a transient provider failure.
PLACES_RETRY_BASE_DELAY_MS=300
PLACES_RETRY_MAX_DELAY_MS=2000
# Timeout for a single Nominatim geocoding call.
GEOCODE_TIMEOUT_MS=5000
# Cache lifetimes.
GEOCODE_CACHE_TTL_MS=604800000
PLACES_CACHE_TTL_MS=43200000
# An empty provider answer is re-checked after this short window.
PLACES_EMPTY_CACHE_TTL_MS=300000
# Past-TTL entries stay servable (stale-while-revalidate) for this long.
PLACES_STALE_CACHE_TTL_MS=21600000
EVENTS_CACHE_TTL_MS=1800000
# Diagnostic log level for external discovery: debug|info|warn|error|silent
DISCOVERY_LOG_LEVEL=info
